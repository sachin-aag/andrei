# Auth.js (NextAuth v5) — required for authentication
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Your Resend API key (from resend.com)
AUTH_RESEND_KEY=
# The "from" address for magic link emails (must match your verified Resend domain).
# If @mjbiopharm.com inboxes block @andreihealth.com, verify mjbiopharm.com in Resend instead.
# See docs/email-deliverability.md
AUTH_EMAIL_FROM=noreply@andreihealth.com
# Canonical app URL for magic-link and password-reset emails (Auth.js AUTH_URL).
# Must be the public host users actually open — a leftover *.vercel.app value
# after a custom-domain cutover makes sessions 401 and breaks ingest workflows.
# MJ production: https://mj.andreihealth.com
# Demo production: https://demo.andreihealth.com
# Local / Playwright: http://localhost:3000 or http://127.0.0.1:3000
# AUTH_URL=https://mj.andreihealth.com
# AUTH_URL=https://demo.andreihealth.com
# AUTH_URL=http://localhost:3000
# Trust Host header when not on Vercel (Docker, Playwright on 127.0.0.1, etc.)
# AUTH_TRUST_HOST=true

# Playwright e2e only — never set on Vercel production or preview deployments
# ALLOW_TEST_LOGIN=true
# TEST_AUTH_EMAIL=test.engineer@mjbiopharm.com
# ALLOW_TEST_SKIP_EVALUATION=true
# ALLOW_TEST_SKIP_SUGGESTIONS=true
# ALLOW_TEST_STUB_MATH_EXTRACTION=true
# ALLOW_TEST_STUB_DOCUMENT_INGEST=true
# ALLOW_TEST_STUB_CHAT=true
# ALLOW_TEST_STUB_SPEECH=true
# ATTACHMENT_STORAGE_BACKEND=local
# ALLOW_LOCAL_ATTACHMENT_STORAGE=true

# Database (one URL per environment — see docs/database-environments.md)
#
# Local Docker (no Neon admin): npm run db:local:up && npm run db:push
# DATABASE_URL=postgresql://andrei:andrei@localhost:5432/andrei_dev
#
# Neon — production/main branch (Vercel Production only)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
#
# Neon — dev branch (localhost + Vercel Preview/Development)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-dev.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://andrei:andrei@localhost:5432/andrei_dev

# Google Gemini API key (optional — used directly by @ai-sdk/google when set).
# Get one from https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Vercel AI Gateway (recommended on Vercel — also used for DOCX formula extraction).
# Enable in the project dashboard, then add this key to Production *and* Preview:
# https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Langfuse observability (Settings -> API Keys).
# JS/TS SDK v5 (>= 5.4.0) for real-time Langfuse v4 ingestion.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=
# LANGFUSE_DEBUG=true

# PostHog (EU) — project API key from https://eu.posthog.com
# Events route via first-party /mj-sync proxy (see next.config.ts rewrites).
NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ALLOW_TEST_STUB_DOCUMENT_INGEST=true

# PDF attachment storage
# Production uses GCS. Local file storage is only allowed when both vars below are set
# and NODE_ENV is not production.
GCS_BUCKET=
# Dedicated bucket for the retrieval eval corpus (CI `--from-gcs`). Prefer this
# over GCS_BUCKET so production attachment bytes are never the eval source.
# One-time: pnpm retrieval-eval:upload
# RETRIEVAL_EVAL_GCS_BUCKET=
# RETRIEVAL_EVAL_GCS_PREFIX=retrieval-eval/
# ATTACHMENT_STORAGE_BACKEND=gcs
# ATTACHMENT_STORAGE_BACKEND=local
# ALLOW_LOCAL_ATTACHMENT_STORAGE=true
# Serve PDF preview bytes straight from GCS instead of proxying them through the
# content route. Needs the app origin in infra/gcs/cors.json applied to the bucket.
# ATTACHMENT_PREVIEW_DIRECT_STORAGE=true
MAX_ATTACHMENT_BYTES=262144000
MAX_ATTACHMENT_PAGES=500
MAX_ATTACHMENTS_PER_REPORT=20
MAX_ATTACHMENT_BYTES_PER_REPORT=1073741824
ATTACHMENT_MALWARE_SCAN_REQUIRED=false

# Workload Identity Federation for Vertex/GCS/Speech on Vercel
# GCP_WIF_AUDIENCE=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_VERTEX_PROJECT=
# Composer voice dictation uses Speech-to-Text v2 Chirp 3 (same project + WIF).
# Hindi/Marathi stay in native script. See infra/speech.

# Document ingest (Vertex AI only for document content — no AI Studio/Gateway fallback)
DOCUMENT_EXTRACT_GOOGLE_MODEL_ID=gemini-3.1-flash-lite
DOCUMENT_EMBEDDING_MODEL_ID=gemini-embedding-001
# Dedicated to extraction — do not reuse GOOGLE_VERTEX_LOCATION (that stays
# whatever embeddings need, often us-central1). Gemini 3.x extract 404s
# outside global.
DOCUMENT_EXTRACT_LOCATION=global

# Document AI Enterprise OCR (scan transcription). Regional — never reuse
# DOCUMENT_EXTRACT_LOCATION=global. Processor ID is the trailing UUID, or the
# full projects/.../processors/... resource name.
# DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_PROCESSOR_ID=

# Customer pack (runtime product overlay). Default is demo.
# Set both to the same value. ANDREI_VERCEL_DEPLOY_SCOPE must agree when set.
# andrei-demo: demo (or unset). andrei-v2: mj. andrei-convergent: convergent.
# ANDREI_CUSTOMER=demo
# NEXT_PUBLIC_ANDREI_CUSTOMER=demo
